{
  "name": "save-and-spend-agentic-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Save & Spend mock finance MVP — modular TypeScript monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preview:live": "bash scripts/ensure-preview.sh",
    "status": "node scripts/status.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "bash scripts/e2e.sh",
    "build": "npm run build --workspaces --if-present",
    "validate": "bash scripts/validate.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "1.62.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
