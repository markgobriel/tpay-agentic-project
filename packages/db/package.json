{
  "name": "@save-and-spend/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "prisma generate --config prisma.config.ts && tsc -b",
    "typecheck": "prisma generate --config prisma.config.ts && tsc -b --pretty false",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "db:local": "node scripts/local-postgres.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@prisma/dev": "0.24.17",
    "@types/pg": "8.21.0",
    "prisma": "7.9.1",
    "tsx": "^4.20.3"
  }
}
